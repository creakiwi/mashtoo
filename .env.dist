LOG_LEVEL=ALL
DEBUG=0

ARCH=x86
MICROARCH=
DIST=gentoo
VERSION=latest
NETINST=1
#SYSINIT=systemd|openrc
SYSINIT=openrc
#PROFILE=server|desktop
PROFILE=server
#LIB_PROFILE=multilib|nomultilib
LIB_PROFILE=multilib

# USB DEVICE ON HOST TO INSTALL LIVECD
USB_DEVICE=/dev/sda
# DEVICE ON TARGET TO INSTALL FINAL DISTRIBUTION
INSTALL_DEVICE=/dev/sda

#BOOT_FIRMWARE=uefi|bios
BOOT_FIRMWARE=uefi

LOCALE_KEYMAP=fr
LOCALE_LANG=fr_FR.UTF-8
