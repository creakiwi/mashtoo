#!/bin/sh
## DESCRIPTION: Interactive process viewer

pkg_install_htop_gentoo() {
    run "emerge sys-process/htop"
}

pkg_install_htop_debian() {
    run "apt-get install -y htop"
}

pkg_uninstall_htop_gentoo() {
    run "emerge -C sys-process/htop"
}

pkg_uninstall_htop_debian() {
    run "apt-get remove -y htop"
}
